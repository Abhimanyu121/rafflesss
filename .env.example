# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- RPC endpoints (foundry.toml reads these) ---
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# --- Deployment ---
PRIVATE_KEY=
FEE_RECIPIENT=
# Who administers the factory. Use a Safe or timelock in production.
# The deploy script asserts ownership landed here.
FACTORY_OWNER=
# Protocol fee in basis points. Default 200 (2%). Hard cap is 1000 (10%).
FEE_BPS=200

# --- Chainlink VRF v2.5 ---
# Values below were taken from docs.chain.link/vrf/v2-5/supported-networks on 2026-09-07.
# Re-check them before deploying: Chainlink does supersede coordinators.
#
#   Base Sepolia  coordinator 0x5C210eF41CD1a72de73bF76eC39637bB0d3d7BEE
#                 key hash    0x9e1344a1247c8a1785d0a4681a27152bffdb43666ae5bf7d14d24a5efd44bf71  (30 gwei)
#   Base mainnet  coordinator 0xd5D517aBE5cF79B7e95eC98dB0f0277788aFF634
#                 key hash    0x00b81b5a830cb0a4009fbd8904de511e28631e62ce5ad231373d3cdad373ccab  (2 gwei)
#                 key hash    0xdc2f87677b01473c763cb0aee938ed3341512f6057324a584e5944e786144d70  (30 gwei)
#
# Both networks: confirmations 0-200, callback gas limit up to 2,500,000.
# Billing on Base (both networks): 50% premium paying in LINK, 60% paying in native ETH.
# Coordinator overhead 150,400 gas (LINK) / 128,500 (native), plus 435 per word.
# The provider rejects fewer than 3 confirmations: Base allows 0, which would make a validator
# re-roll cheap, and it cannot be corrected for a request already in flight.
VRF_COORDINATOR=
VRF_KEY_HASH=
VRF_SUBSCRIPTION_ID=
VRF_CONFIRMATIONS=3
# Fulfilment measures ~27k gas. The provider enforces a 100,000 floor, because a callback that
# runs out of gas loses that seed permanently — Chainlink cannot retry it.
VRF_CALLBACK_GAS=200000
# true pays in native ETH, false pays in LINK
VRF_NATIVE_PAYMENT=false
